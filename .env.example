# =============================================================================
# Variables de entorno — Landing Page Dinámica (React + FastAPI)
# =============================================================================
# Producción (tuxserver): copiar a .env con chmod 600
#   cp .env.example .env && chmod 600 .env
# =============================================================================

ENVIRONMENT=development
APP_NAME="TuxEng Landing"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# En producción (tuxserver) apunta a db-postgres y db-redis en internal_net:
DATABASE_URL="postgresql+psycopg://landing_user:CAMBIAR_CLAVE_DB@db-postgres:5432/landing_db"
REDIS_URL="redis://:CAMBIAR_CLAVE_REDIS@db-redis:6379/0"

# Seguridad JWT (generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY="CAMBIAR_POR_CLAVE_SECRETA_LARGA"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador inicial (se crea automáticamente al arrancar si no existe)
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_INITIAL_PASSWORD="CAMBIAR_CLAVE_ADMIN"

# Subida de archivos (volumen persistente /mnt/raid/docker/landing/uploads)
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_MB=5

# Notificación inmediata por Telegram cuando llega un nuevo lead (opcional)
TELEGRAM_LEADS_ENABLED=false
TELEGRAM_LEADS_BOT_TOKEN=""
TELEGRAM_LEADS_CHAT_ID=""
